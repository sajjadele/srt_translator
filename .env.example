# ==========================================
# Telegram Bot Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# ==========================================
# LLM Provider Configuration
# ==========================================
# Option A: Google Gemini Free Tier (Fast & Free, recommended)
# نکته: سهمیه‌ی Free Tier در سطح «کلید» است و بین همه‌ی مدل‌های یک کلید مشترک است.
# با تمام شدن آن، تعویض مدل هیچ فایده‌ای ندارد؛ اما با افزودن کلید دوم به LLM_API_KEYS
# ظرفیت روزانه دو برابر می‌شود (هر کلید ۵۰۰ درخواست در روز).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your_gemini_api_key_here
# کلیدهای پشتیبان، جدا شده با کاما — هنگام اتمام سهمیه‌ی هر کلید، خودکار به بعدی می‌رود
LLM_API_KEYS=your_first_key_here,your_second_key_here
LLM_MODELS=gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.8-flash,gemini-3.5-flash-lite

# Option B: byNara Router
# LLM_BASE_URL=https://router.bynara.id/v1
# LLM_API_KEY=your_bynara_api_key_here
# LLM_MODELS=agnes-2.5-flash,minimax-m3

# ==========================================
# Batching & Performance Settings
# ==========================================
BATCH_SIZE=35
PRE_CONTEXT_SIZE=2
POST_CONTEXT_SIZE=2
REQUEST_TIMEOUT=90
INTER_BATCH_DELAY=3.5
