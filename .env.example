# ==========================================
# Telegram Bot Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# ==========================================
# LLM Provider Configuration
# ==========================================
# Option A: byNara Router (Free model: nemotron-3-super-free)
LLM_BASE_URL=https://router.bynara.id/v1
LLM_API_KEY=your_bynara_api_key_here
LLM_MODELS=nemotron-3-super-free

# Option B: Google Gemini (OpenAI compatible)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# ==========================================
# Batching & Performance Settings
# ==========================================
BATCH_SIZE=25
PRE_CONTEXT_SIZE=2
POST_CONTEXT_SIZE=2
REQUEST_TIMEOUT=90
