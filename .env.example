# ==========================================
# Telegram Bot Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# ==========================================
# LLM Provider Configuration
# ==========================================
# Option A: Google Gemini (Recommended - Free Tier & High Precision)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your_gemini_api_key_here
LLM_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Option B: OpenAI / OpenRouter / Bynara Router
# LLM_BASE_URL=https://router.bynara.id/v1
# LLM_API_KEY=your_router_api_key_here
# LLM_MODELS=agnes-2.5-flash,minimax-m3,deepseek-v4-flash

# ==========================================
# Batching & Performance Settings
# ==========================================
BATCH_SIZE=15
PRE_CONTEXT_SIZE=2
POST_CONTEXT_SIZE=2
REQUEST_TIMEOUT=60
